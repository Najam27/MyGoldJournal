# Core application configuration
VITE_APP_ID=
JWT_SECRET=
# Required in production; use a 32+ character secret dedicated to MT5 API-key encryption.
MT5_ENCRYPTION_KEY=
# Supabase PostgreSQL: use the transaction pooler URL (port 6543) for Netlify Functions.
# Use the session pooler URL (port 5432) for drizzle-kit migrations and one-time imports.
# Keep this server-only; never prefix it with VITE_.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# Manus built-in storage and API services
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Legacy source database used only by scripts/export-mysql-data.ts during migration.
# MYSQL_DATABASE_URL=
# Optional path to the JSON export used by import/verification scripts.
# MYSQL_EXPORT_FILE=./migration/mysql-export.json

# Optional Umami analytics. Leave both blank to disable analytics.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
